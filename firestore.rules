rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsPatient(patientId) {
      return signedIn()
        && exists(/databases/$(database)/documents/patients/$(patientId))
        && get(/databases/$(database)/documents/patients/$(patientId)).data.ownerUid == request.auth.uid;
    }

    match /patients/{patientId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid;

      allow get, list: if signedIn()
        && resource.data.ownerUid == request.auth.uid;

      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid;

      allow delete: if signedIn()
        && resource.data.ownerUid == request.auth.uid;

      match /footScans/{scanId} {
        allow read, create, update, delete: if ownsPatient(patientId);
      }
    }
  }
}
